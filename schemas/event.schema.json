{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eventhorizon.local/schemas/event.schema.json",
  "title": "Event Horizon event",
  "type": "object",
  "additionalProperties": true,
  "required": ["schemaVersion", "eventId", "eventName", "date"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "eventId": { "$ref": "#/$defs/id" },
    "eventName": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "timezone": { "type": "string", "default": "America/New_York" },
    "startTime": { "$ref": "#/$defs/time" },
    "endTime": { "$ref": "#/$defs/time" },
    "status": { "$ref": "#/$defs/eventStatus" },
    "venue": { "$ref": "#/$defs/venue" },
    "organizer": { "type": "string" },
    "staff": { "type": "array", "items": { "$ref": "#/$defs/staff" } },
    "schedule": { "type": "array", "items": { "$ref": "#/$defs/activity" } },
    "djs": { "type": "array", "items": { "$ref": "#/$defs/dj" } },
    "games": { "type": "array", "items": { "$ref": "#/$defs/gameInstance" } },
    "scripts": { "type": "array", "items": { "$ref": "#/$defs/script" } },
    "contests": { "type": "array", "items": { "$ref": "#/$defs/contest" } },
    "prizes": { "type": "array", "items": { "$ref": "#/$defs/prize" } },
    "notes": { "type": "array", "items": { "$ref": "#/$defs/note" } },
    "checklists": { "type": "array", "items": { "$ref": "#/$defs/check" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$" },
    "time": { "type": "string" },
    "eventStatus": { "enum": ["Draft", "Planned", "Ready", "Live", "Completed", "Archived"] },
    "activityStatus": { "enum": ["Scheduled", "Live", "Completed", "Skipped", "Delayed", "Paused"] },
    "category": { "enum": ["Welcome", "Announcement", "DjSet", "Game", "Contest", "Giveaway", "Break", "Intermission", "Closing", "Custom"] },
    "format": { "enum": ["MultipleChoice", "QuestionAnswer", "Elimination", "Points", "Tournament", "Voting", "Collection", "Custom"] },
    "scriptCategory": { "enum": ["Welcome", "DjIntroduction", "DjTransition", "GameIntroduction", "GameInstructions", "GameCommentary", "WinnerAnnouncement", "Giveaway", "GeneralAnnouncement", "Closing", "Custom"] },
    "reward": { "enum": ["Gil", "AetherCoins", "Item", "Custom"] },
    "award": { "enum": ["NotAwarded", "Pending", "Awarded"] },
    "venue": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "name": { "type": "string" },
        "dataCenter": { "type": "string" },
        "world": { "type": "string" },
        "district": { "type": "string" },
        "ward": { "type": "string" },
        "plot": { "type": "string" },
        "notes": { "type": "string" }
      }
    },
    "staff": {
      "type": "object",
      "required": ["staffId"],
      "properties": {
        "staffId": { "$ref": "#/$defs/id" },
        "name": { "type": "string" },
        "role": { "type": "string" },
        "notes": { "type": "string" }
      }
    },
    "activity": {
      "type": "object",
      "required": ["activityId"],
      "properties": {
        "activityId": { "$ref": "#/$defs/id" },
        "startTime": { "$ref": "#/$defs/time" },
        "endTime": { "$ref": "#/$defs/time" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "category": { "$ref": "#/$defs/category" },
        "djId": { "$ref": "#/$defs/id" },
        "gameInstanceId": { "$ref": "#/$defs/id" },
        "scriptId": { "$ref": "#/$defs/id" },
        "prizeId": { "$ref": "#/$defs/id" },
        "hostNotes": { "type": "string" },
        "status": { "$ref": "#/$defs/activityStatus" }
      }
    },
    "dj": {
      "type": "object",
      "required": ["djId"],
      "properties": {
        "djId": { "$ref": "#/$defs/id" },
        "name": { "type": "string" },
        "startTime": { "$ref": "#/$defs/time" },
        "endTime": { "$ref": "#/$defs/time" },
        "streamUrl": { "type": "string" },
        "introScriptId": { "$ref": "#/$defs/id" },
        "transitionScriptId": { "$ref": "#/$defs/id" },
        "introText": { "type": "string" },
        "transitionText": { "type": "string" },
        "notes": { "type": "string" }
      }
    },
    "round": {
      "type": "object",
      "required": ["roundId"],
      "properties": {
        "roundId": { "$ref": "#/$defs/id" },
        "title": { "type": "string" },
        "prompt": { "type": "string" },
        "description": { "type": "string" },
        "choices": { "type": "array", "items": { "type": "string" } },
        "correctAnswer": { "type": "string" },
        "explanation": { "type": "string" },
        "sourceReference": { "type": "string" },
        "featuredStaff": { "type": "string" },
        "imagePath": { "type": "string" },
        "hostNotes": { "type": "string" },
        "announcement": { "type": "string" },
        "extras": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "match": {
      "type": "object",
      "required": ["matchId"],
      "properties": {
        "matchId": { "$ref": "#/$defs/id" },
        "round": { "type": "integer" },
        "playerA": { "type": "string" },
        "playerB": { "type": "string" },
        "players": { "type": "array", "items": { "type": "string" } },
        "nextMatchId": { "$ref": "#/$defs/id" },
        "nextSeat": { "type": "integer" },
        "winner": { "type": "string" },
        "notes": { "type": "string" }
      }
    },
    "gameInstance": {
      "type": "object",
      "required": ["instanceId"],
      "properties": {
        "instanceId": { "$ref": "#/$defs/id" },
        "templateId": { "$ref": "#/$defs/id" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "category": { "type": "string" },
        "formats": { "type": "array", "items": { "$ref": "#/$defs/format" } },
        "rules": { "type": "string" },
        "introScript": { "type": "string" },
        "closingScript": { "type": "string" },
        "prizeId": { "$ref": "#/$defs/id" },
        "scoringMethod": { "type": "string" },
        "participationMethod": { "type": "string" },
        "hostNotes": { "type": "string" },
        "rounds": { "type": "array", "items": { "$ref": "#/$defs/round" } },
        "tournament": {
          "type": "object",
          "properties": {
            "format": { "type": "string" },
            "seats": { "type": "integer", "minimum": 2, "maximum": 8 },
            "matches": { "type": "array", "items": { "$ref": "#/$defs/match" } }
          }
        }
      }
    },
    "script": {
      "type": "object",
      "required": ["scriptId", "title"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "scriptId": { "$ref": "#/$defs/id" },
        "title": { "type": "string" },
        "category": { "$ref": "#/$defs/scriptCategory" },
        "spokenText": { "type": "string" },
        "stageDirections": { "type": "string" },
        "announcement": { "type": "string" },
        "eventId": { "$ref": "#/$defs/id" },
        "activityId": { "$ref": "#/$defs/id" },
        "sourceScriptId": { "$ref": "#/$defs/id" },
        "hostNotes": { "type": "string" }
      }
    },
    "clue": {
      "type": "object",
      "required": ["clueId"],
      "properties": {
        "clueId": { "$ref": "#/$defs/id" },
        "content": { "type": "string" },
        "revealTime": { "$ref": "#/$defs/time" },
        "hostNotes": { "type": "string" }
      }
    },
    "contest": {
      "type": "object",
      "required": ["contestId"],
      "properties": {
        "contestId": { "$ref": "#/$defs/id" },
        "title": { "type": "string" },
        "contestType": { "type": "string" },
        "rules": { "type": "string" },
        "startTime": { "$ref": "#/$defs/time" },
        "deadline": { "$ref": "#/$defs/time" },
        "prizeId": { "$ref": "#/$defs/id" },
        "submissionMethod": { "type": "string" },
        "winnerMethod": { "type": "string" },
        "winner": { "type": "string" },
        "notes": { "type": "string" },
        "clues": { "type": "array", "items": { "$ref": "#/$defs/clue" } }
      }
    },
    "prize": {
      "type": "object",
      "required": ["prizeId"],
      "properties": {
        "prizeId": { "$ref": "#/$defs/id" },
        "gameInstanceId": { "$ref": "#/$defs/id" },
        "contestId": { "$ref": "#/$defs/id" },
        "activityId": { "$ref": "#/$defs/id" },
        "rewardType": { "$ref": "#/$defs/reward" },
        "rewardName": { "type": "string" },
        "amount": { "type": "number" },
        "allowMultipleWinners": { "type": "boolean" },
        "status": { "$ref": "#/$defs/award" },
        "winners": { "type": "array", "items": { "type": "string" } },
        "notes": { "type": "string" }
      }
    },
    "note": {
      "type": "object",
      "required": ["noteId"],
      "properties": {
        "noteId": { "$ref": "#/$defs/id" },
        "title": { "type": "string" },
        "category": { "type": "string" },
        "body": { "type": "string" }
      }
    },
    "check": {
      "type": "object",
      "required": ["itemId"],
      "properties": {
        "itemId": { "$ref": "#/$defs/id" },
        "text": { "type": "string" },
        "done": { "type": "boolean" }
      }
    }
  }
}

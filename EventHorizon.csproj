<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <AssemblyName>EventHorizon</AssemblyName>
    <Product>Event Horizon</Product>
    <Version>1.0.6.0</Version>
    <Description>Plan a party, then host it live. Events, games, and scripts are JSON files, so a new party does not require a new build.</Description>
    <Authors>Event Horizon</Authors>
    <Author>Event Horizon</Author>
    <Name>Event Horizon</Name>
    <Punchline>Plan a party, then host it live.</Punchline>
    <DalamudApiLevel>15</DalamudApiLevel>
    <ApplicableVersion>any</ApplicableVersion>
    <Tags>events,roleplay,hosting</Tags>
    <AcceptsFeedback>false</AcceptsFeedback>
    <RepoUrl>https://github.com/NeonCelestialLanes/EventHorizon</RepoUrl>
    <IconUrl>https://raw.githubusercontent.com/NeonCelestialLanes/EventHorizon/main/images/icon.png</IconUrl>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="EventHorizon.Verify\**" />
    <Content Remove="EventHorizon.Verify\**" />
    <None Remove="EventHorizon.Verify\**" />
    <EmbeddedResource Remove="EventHorizon.Verify\**" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="EventHorizon.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Examples\**\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="schemas\**\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="images\icon.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>EventHorizon.Verify</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
